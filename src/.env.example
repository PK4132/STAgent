# Example environment configuration for STAgent

# LM Studio local endpoint (used by Squidpy/SpatialData RAG pipeline)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=gemma4-e2b
LM_STUDIO_EMBEDDING_MODEL=nomic-embed-text-v1.5

# RAG code execution (execute node).
# Generated code runs in a spawned interpreter that re-imports squidpy and
# spatialdata, so allow generous time when loading real datasets.
RAG_EXEC_ENABLED=true
RAG_EXEC_TIMEOUT=300
RAG_MAX_REWRITE_ATTEMPTS=3

# RAG index provenance. The vendored repos under packages_available/ are checked out at
# these refs before indexing. Keep RAG_SPATIALDATA_REF in step with the installed wheel
# (environment.yml): if the index describes a different version than the interpreter has,
# generated code will call APIs that do not exist and no retry can fix it.
# Leave a ref empty to index whatever the clone is currently on.
RAG_SPATIALDATA_REF=v0.7.3
RAG_SQUIDPY_REF=
# auto = re-embed only the repos whose commit moved, never = warn but serve the old
# index, force = re-embed everything
RAG_INDEX_REFRESH=auto

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
# Optional OpenAI-compatible base URL override
OPENAI_API_BASE=
# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Google Gemini
GOOGLE_API_KEY=your-google-api-key-here
# Search and voice
SERP_API_KEY=your-serp-api-key-here
WHISPER_API_KEY=your-whisper-api-key-here
